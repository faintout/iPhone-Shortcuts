# 必填：替换为至少 12 个字符的登录密码；空值会阻止服务启动。
ADMIN_PASSWORD=yhnyhn

# 必填：至少 32 个字符，不能包含空白；在 iPhone 快捷指令的请求头中使用。
# Authorization: Bearer <DEVICE_TOKEN>，仅能拉取及确认设备任务。
DEVICE_TOKEN=

# 可选：供外部程序调用本服务 API，至少 32 个字符；留空则禁用 Bearer 登录。
# 必须与 DEVICE_TOKEN 不同；不要将此管理员 Token 填入手机快捷指令。
API_TOKEN=

# 通过 HTTPS 反向代理访问时设置为 true；本机 HTTP 调试使用 false。
COOKIE_SECURE=false

TIMEZONE=Asia/Shanghai
HOST=0.0.0.0
PORT=3000
DATA_DIR=./data
